# Sardonyx in its image. The nginx image fills in ${BACKEND_HOST},
# ${RESOLVER} and ${FILE_LINK_SECRET} from the environment when the
# container starts.

# The path of an API request as the browser sent it, without /api: still
# encoded, so that a tag called "a/b" (/api/tag/a%2Fb) reaches the server as
# one name and not as two path segments. With the query string.
map $request_uri $lithica_path {
    "~^/api(?<rest>/.*)$" $rest;
    default /;
}

# The policy of the app's own pages: everything from this site and nothing
# from anywhere else, no inline or evaluated script, no plugins, never in a
# frame. Inline styles are allowed: React and the UI components set style
# attributes. Defined once here and sent by each location below, since an
# add_header inside a location replaces those of the server.
map "" $app_csp {
    default "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'";
}

# The policies of the frame styled card text is shown in (5.4b,
# public/frame/card-text.html). The frame is sandboxed by the page that
# embeds it (scripts, no same origin), and its policy lets run its one
# inline script, named by hash (src/text/frame.test.ts checks the hash), and
# no other: none of the card's. Card styles are inline; nothing connects,
# and only this site may frame it. Without images (the default) a card may
# show data: pictures and fonts only; with images, after the viewer asked for
# that card, https ones too. The sandbox directive keeps the page sandboxed
# when it is opened by itself.
map "" $frame_csp {
    default "default-src 'none'; script-src 'sha256-7nSh/nsHZOMKG/CFYwTRwbNanPH0NR0gWXqvZG4SUB8='; style-src 'unsafe-inline'; img-src data:; font-src data:; frame-ancestors 'self'; sandbox allow-scripts allow-popups allow-popups-to-escape-sandbox";
}
map "" $frame_images_csp {
    default "default-src 'none'; script-src 'sha256-7nSh/nsHZOMKG/CFYwTRwbNanPH0NR0gWXqvZG4SUB8='; style-src 'unsafe-inline'; img-src https: data:; font-src https: data:; frame-ancestors 'self'; sandbox allow-scripts allow-popups allow-popups-to-escape-sandbox";
}

# The policy of an uploaded file opened by itself: it may run nothing and
# load nothing, whatever it is or claims to be.
map "" $upload_csp {
    default "default-src 'none'; sandbox";
}

# Signed file links (the server's file_link_secret, given here as
# FILE_LINK_SECRET; README, "Signed file links"). The files of posts and
# their thumbnails are served only to an address the server signed: nginx's
# secure_link, ?e=<expiry>&s=<base64url of md5("<expiry><path> <secret>")>,
# where <path> is the file's path under /data (/posts/5_abc.png), as the
# server signs it. Avatars are not signed. Without a secret, as before.
map $uri $lithica_signed_path {
    "~^/data(?<rest>/(posts|generated-thumbnails)/.+)$" $rest;
    default "";
}
map "${FILE_LINK_SECRET}" $lithica_file_links_signed {
    "" 0;
    default 1;
}
# refused: links are signed, the file is one that is signed, and its
# signature is missing, wrong or expired ($secure_link is 1 only if valid)
map "$lithica_file_links_signed:$lithica_signed_path:$secure_link" $lithica_link_refused {
    "~^0:" 0;
    "~^1::" 0;
    "~^1:/[^:]+:1$" 0;
    default 1;
}

server {
    listen 80;
    listen [::]:80;
    server_name _;

    root /usr/share/nginx/html;

    # as large as the largest request the server takes (max_upload_size)
    client_max_body_size 1G;

    resolver ${RESOLVER} valid=10s ipv6=off;

    # Compressed on the way out: the API's JSON (a card with a large
    # lorebook is megabytes of it) and the app's scripts and styles. Not
    # what is small enough not to gain, and not the uploads: pictures are
    # compressed already, and a download is the stored file, byte for byte.
    # (text/html is always on the list.) gzip_proxied: also when a proxy in
    # front of this one asks.
    gzip on;
    gzip_comp_level 5;
    gzip_min_length 1024;
    gzip_proxied any;
    gzip_vary on;
    gzip_types application/json application/javascript text/javascript text/css image/svg+xml;

    # the API: everything under /api/ goes to the server, without the prefix
    location /api/ {
        proxy_pass http://${BACKEND_HOST}:6666$lithica_path;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # uploads and downloads of large files take their time
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }

    # the uploaded files and their thumbnails, from the data volume, read-only
    location /data/ {
        alias /data/;
        secure_link $arg_s,$arg_e;
        secure_link_md5 "$secure_link_expires$lithica_signed_path ${FILE_LINK_SECRET}";
        if ($lithica_link_refused) {
            return 403;
        }
        # somebody's upload: a browser must not guess at what it is, and
        # opened by itself it can run nothing
        add_header X-Content-Type-Options nosniff always;
        add_header Content-Security-Policy $upload_csp always;
        expires 7d;
    }

    # Files uploaded ahead of the request that uses them. The API refers to
    # them by token; nothing of the client fetches them, and nobody else
    # should. (^~: no other location is looked at for these paths.)
    location ^~ /data/temporary-uploads/ {
        return 404;
    }

    # The frame of styled card text, without images and with them: one page
    # under two paths, each with its policy. Never cached: the policy names
    # the page's script by hash.
    location = /frame/card-text.html {
        add_header Content-Security-Policy $frame_csp always;
        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy no-referrer always;
        add_header Cache-Control "no-cache" always;
        try_files /frame/card-text.html =404;
    }
    location = /frame/card-text-images.html {
        add_header Content-Security-Policy $frame_images_csp always;
        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy no-referrer always;
        add_header Cache-Control "no-cache" always;
        try_files /frame/card-text.html =404;
    }

    # the app's own files carry their content's hash in their names
    location /assets/ {
        add_header Content-Security-Policy $app_csp always;
        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy same-origin always;
        # for old browsers; frame-ancestors says it to the rest
        add_header X-Frame-Options DENY always;
        add_header Cache-Control "public, immutable" always;
        expires 1y;
        try_files $uri =404;
    }

    # The page a password reset mail links to: its address holds the reset
    # token until the app takes it off. Not in the access log, and no
    # Referer of it with the requests the page makes (the app's files).
    location ^~ /password-reset/ {
        access_log off;
        add_header Content-Security-Policy $app_csp always;
        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy no-referrer always;
        add_header X-Frame-Options DENY always;
        add_header Cache-Control "no-store" always;
        try_files /index.html =404;
    }

    # every other path is a page of the app, which finds its way from there
    location / {
        add_header Content-Security-Policy $app_csp always;
        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy same-origin always;
        # for old browsers; frame-ancestors says it to the rest
        add_header X-Frame-Options DENY always;
        add_header Cache-Control "no-cache" always;
        try_files $uri /index.html;
    }
}
