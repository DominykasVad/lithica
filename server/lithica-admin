#!/usr/bin/env python3

"""
Collection of CLI commands for an administrator to use
"""

import logging
import os
import re
import sys
from argparse import ArgumentParser
from getpass import getpass
from sys import stderr

from lithica import config, db, errors, model, registry
from lithica.func import auth, files, images, post_import, util
from lithica.func import posts as postfuncs
from lithica.func import users as userfuncs


def reset_password(username: str) -> None:
    user = userfuncs.get_user_by_name_or_email(username)

    new_password = getpass("Enter new password for '%s': " % user.name)
    check_password = getpass("Re-enter password: ")

    if check_password != new_password:
        raise errors.ValidationError("Passwords do not match")

    userfuncs.update_user_password(user, new_password)
    db.get_session().commit()
    print("Sucessfully changed password for '%s'" % user.name)


# the ranks an account can have; anonymous and nobody are not accounts
USER_RANKS = [
    rank
    for internal, rank in auth.RANK_MAP.items()
    if internal not in (model.User.RANK_ANONYMOUS, model.User.RANK_NOBODY)
]


def _read_new_password(name: str, from_stdin: bool) -> str:
    if from_stdin:
        return sys.stdin.readline().rstrip("\r\n")
    # never an argument (the shell's history, the process list) and never
    # read silently off a pipe: asked twice on the terminal, or --password-stdin
    if not sys.stdin.isatty():
        raise errors.ValidationError(
            "No terminal to ask the password on: give it on standard input "
            "with --password-stdin."
        )
    password = getpass("Password for '%s': " % name)
    if getpass("Re-enter password: ") != password:
        raise errors.ValidationError("Passwords do not match")
    return password


def create_user(
    name: str, rank: str | None, email: str | None, password_stdin: bool
) -> bool:
    try:
        password = _read_new_password(name, password_stdin)
        first = userfuncs.get_user_count() == 0
        # the site's rules for names, passwords and emails, as for a sign-up
        user = userfuncs.create_user(name, password, email or "")
        if rank is None:
            rank = "administrator" if first else "regular"
        user.rank = util.flip(auth.RANK_MAP)[rank]
        db.session.add(user)
        db.session.commit()
    except errors.BaseError as e:
        db.session.rollback()
        print(e, file=sys.stderr)
        return False
    print("Created user '%s' with rank %s" % (user.name, rank))
    return True


def check_audio() -> None:
    post_list = (
        db.session.query(model.Post)
        .filter(model.Post.type == model.Post.TYPE_VIDEO)
        .order_by(model.Post.post_id)
        .all()
    )

    for post in post_list:
        print("Checking post %d ..." % post.post_id, end="\r", file=stderr)
        content = files.get(postfuncs.get_post_content_path(post))

        has_existing_flag = model.Post.FLAG_SOUND in post.flags
        try:
            has_sound_data = images.Image(content).check_for_sound()
        except errors.ProcessingError:
            print("Post %d caused an error when checking for sound" % post.post_id)

        if has_sound_data and not has_existing_flag:
            print("Post %d has sound data but is not flagged" % post.post_id)
        if not has_sound_data and has_existing_flag:
            print("Post %d has no sound data but is flagged" % post.post_id)


def reset_filenames() -> None:
    regex = re.compile(r"(\d+)_[0-9a-f]{16}\.(\S+)")

    def convert_to_new_filename(old_name: str) -> str:
        matches = regex.match(old_name)
        if not matches:
            return None
        post_id = int(matches.group(1))
        post_ext = matches.group(2)
        return "%d_%s.%s" % (
            post_id,
            postfuncs.get_post_security_hash(post_id),
            post_ext,
        )

    def rename_in_dir(dir: str) -> None:
        for old_path in os.listdir(config.config["data_dir"] + dir):
            new_path = convert_to_new_filename(old_path)
            if not new_path:
                continue
            if old_path != new_path:
                print("%s -> %s" % (dir + old_path, dir + new_path))
                os.rename(
                    config.config["data_dir"] + dir + old_path,
                    config.config["data_dir"] + dir + new_path,
                )

    rename_in_dir("posts/")
    rename_in_dir("generated-thumbnails/")
    rename_in_dir("posts/custom-thumbnails/")


def regenerate_thumbnails() -> None:
    for post in db.session.query(model.Post).all():
        print("Generating tumbnail for post %d ..." % post.post_id, end="\r")
        try:
            postfuncs.generate_post_thumbnail(post)
        except Exception:
            pass


BACKFILLS = {
    "signatures": (
        "image signatures, used by the similar-image search",
        postfuncs.count_posts_without_signature,
        postfuncs.update_all_post_signatures,
    ),
    "md5": (
        "MD5 checksums",
        postfuncs.count_posts_without_md5_checksum,
        postfuncs.update_all_md5_checksums,
    ),
}


def backfill(what: str) -> bool:
    """Run the named backfill, or all of them. Returns False if any post failed."""
    names = list(BACKFILLS) if what == "all" else [what]
    success = True
    for name in names:
        description, count_pending, run = BACKFILLS[name]
        pending = count_pending()
        print("%s: %d posts to process (%s)" % (name, pending, description))
        if not pending:
            continue
        filled, failed = run()
        print("%s: %d done, %d failed" % (name, filled, failed))
        if failed:
            success = False
            print(
                "%s: the failed posts are listed in the log above; "
                "their files are missing or cannot be read" % name,
                file=sys.stderr,
            )
    return success


def reextract(kind: str | None) -> bool:
    """
    Run the extractors of the loaded modules over the existing posts.
    Returns False if a post failed or the kind is not known.
    """
    known_kinds = sorted(registry.content_kinds())
    if not known_kinds:
        print("reextract: no loaded module extracts content; nothing to do")
        return True
    if kind is not None and kind not in known_kinds:
        print(
            "reextract: no loaded module has the content kind %r. Known kinds: %s"
            % (kind, ", ".join(known_kinds)),
            file=sys.stderr,
        )
        return False
    kinds = None if kind is None else [kind]
    pending = postfuncs.count_posts_to_reextract(kinds)
    print(
        "reextract: %d posts to process (%s)"
        % (pending, "kind " + kind if kind else "kinds " + ", ".join(known_kinds))
    )
    if not pending:
        return True
    done, failed = postfuncs.reextract_all_post_contents(kinds)
    print("reextract: %d done, %d failed" % (done, failed))
    if failed:
        print(
            "reextract: the failed posts are listed in the log above; their "
            "files are missing or an extractor failed on them. What had been "
            "extracted from them before was kept",
            file=sys.stderr,
        )
    return not failed


def import_folder(
    folder: str, user: str, safety: str, tags: str | None, dry_run: bool
) -> bool:
    """
    Make a post of every file in a folder. Returns False if the import
    could not start or a file failed; a file that was refused for what it
    is (a duplicate, a type nobody knows) is reported and is no failure.
    """
    if not os.path.isdir(folder):
        print("import: %s is not a folder" % folder, file=sys.stderr)
        return False
    tag_names = [name.strip() for name in (tags or "").split(",") if name.strip()]
    try:
        result = post_import.import_folder(folder, user, safety, tag_names, dry_run)
    except errors.BaseError as e:
        print("import: %s" % e, file=sys.stderr)
        return False

    counts = [
        (result.count(status), status)
        for status in [
            post_import.CREATED,
            post_import.SKIPPED,
            post_import.REFUSED,
            post_import.FAILED,
        ]
    ]
    print(
        "import: %d files%s: %s"
        % (
            len(result.outcomes),
            " (dry run, nothing was created)" if dry_run else "",
            ", ".join(
                "%d %s"
                % (
                    count,
                    "would be created" if dry_run and status == "created" else status,
                )
                for count, status in counts
            ),
        )
    )
    if result.problems:
        print("import: problems:")
        for outcome in result.problems:
            print("  %s  %s: %s" % (outcome.status, outcome.path, outcome.detail))
    return not result.count(post_import.FAILED)


def main(args: list[str] | None = None) -> int:
    # the modules of this installation bring their own commands
    try:
        registry.load_configured()
    except errors.ConfigError as e:
        print(e, file=sys.stderr)
        return 1
    module_commands = {command.name: command for command in registry.admin_commands()}

    parser_top = ArgumentParser(
        description="Collection of CLI commands for an administrator to use",
        epilog="Look at README.md for more info",
    )
    subparsers = parser_top.add_subparsers(dest="subcommand", metavar="<command>")
    parser_backfill = subparsers.add_parser(
        "backfill",
        help="compute data that is missing on existing posts",
        description="Compute data that is missing on existing posts. Safe to "
        "repeat: only posts that still lack the data are processed.",
    )
    parser_backfill.add_argument(
        "what",
        choices=[*BACKFILLS, "all"],
        help="; ".join(
            "%s: %s" % (name, description)
            for name, (description, _count, _run) in BACKFILLS.items()
        )
        + "; all: every backfill",
    )
    parser_reextract = subparsers.add_parser(
        "reextract",
        help="read the content embedded in the files of existing posts again",
        description="Run the extractors of the modules that are switched on "
        "over the files of the existing posts and replace what was extracted "
        "before. For when a module has been switched on or updated. Safe to "
        "repeat. Tags are not changed.",
    )
    parser_reextract.add_argument(
        "--kind",
        metavar="<kind>",
        help="only extract content of this kind, and leave the rest as it is",
    )
    parser_import = subparsers.add_parser(
        "import",
        help="make a post of every file in a folder",
        description="Make a post of every file in a folder and the folders in "
        "it, in the order of their names, as an upload would: with thumbnails, "
        "and with what the modules that are switched on read out of the files "
        "and the tags they add. A file that is a post already is skipped, so "
        "the command is safe to repeat. Files whose names start with a dot are "
        "left out. The files are copied; the folder is not changed.",
    )
    parser_import.add_argument("folder", help="the folder to import")
    parser_import.add_argument(
        "--user",
        required=True,
        metavar="<username>",
        help="the user the posts are uploaded as",
    )
    parser_import.add_argument(
        "--safety",
        required=True,
        choices=["safe", "sketchy", "unsafe"],
        help="the safety of every post that is created",
    )
    parser_import.add_argument(
        "--tags",
        metavar="<tag,tag>",
        help="tags to put on every post, comma-separated; created if missing",
    )
    parser_import.add_argument(
        "--dry-run",
        action="store_true",
        help="say what would happen to each file without creating a post. It "
        "finds duplicates, files of an unknown type and files a module "
        "refuses; a picture that is broken is found by the import only",
    )
    parser_create_user = subparsers.add_parser(
        "create-user",
        help="create an account, such as the site's first administrator",
        description="Create an account, whatever the site's visibility and "
        "sign-up settings. The password is asked twice on the terminal, or "
        "read from the first line of standard input with --password-stdin; "
        "it is never an argument. The name, password and email must meet "
        "the site's rules (user_name_regex, password_regex).",
    )
    parser_create_user.add_argument("name", help="the name of the account")
    parser_create_user.add_argument(
        "--rank",
        choices=USER_RANKS,
        help="the rank of the account; by default administrator when the "
        "site has no account yet, else regular",
    )
    parser_create_user.add_argument(
        "--email", metavar="<email>", help="the email of the account"
    )
    parser_create_user.add_argument(
        "--password-stdin",
        action="store_true",
        help="read the password from the first line of standard input",
    )
    for module_command in module_commands.values():
        parser_module = subparsers.add_parser(
            module_command.name,
            help=module_command.help,
            description=module_command.help,
        )
        if module_command.configure:
            module_command.configure(parser_module)
    parser = parser_top.add_mutually_exclusive_group()
    parser.add_argument(
        "--change-password",
        metavar="<username>",
        help="change the password of specified user",
    )
    parser.add_argument(
        "--check-all-audio",
        action="store_true",
        help="check the audio flags of all posts, "
        "noting discrepancies, without modifying posts",
    )
    parser.add_argument(
        "--reset-filenames",
        action="store_true",
        help="reset and rename the content and thumbnail "
        "filenames in case of a lost/changed secret key",
    )
    parser.add_argument(
        "--regenerate-thumbnails",
        action="store_true",
        help="regenerate the thumbnails for posts if the thumbnail files are missing",
    )
    command = parser_top.parse_args(args)
    options = [
        command.change_password,
        command.check_all_audio,
        command.reset_filenames,
        command.regenerate_thumbnails,
    ]
    if bool(command.subcommand) == any(options):
        parser_top.error("give one command or one option")

    # one command is one unit of work with its own database session
    with db.session_scope():
        try:
            if command.subcommand == "backfill":
                logging.basicConfig(level=logging.INFO, format="%(message)s")
                if not backfill(command.what):
                    return 1
            elif command.subcommand == "reextract":
                logging.basicConfig(level=logging.INFO, format="%(message)s")
                if not reextract(command.kind):
                    return 1
            elif command.subcommand == "import":
                logging.basicConfig(level=logging.INFO, format="%(message)s")
                if not import_folder(
                    command.folder,
                    command.user,
                    command.safety,
                    command.tags,
                    command.dry_run,
                ):
                    return 1
            elif command.subcommand == "create-user":
                if not create_user(
                    command.name,
                    command.rank,
                    command.email,
                    command.password_stdin,
                ):
                    return 1
            elif command.subcommand in module_commands:
                return module_commands[command.subcommand].run(command)
            elif command.change_password:
                reset_password(command.change_password)
            elif command.check_all_audio:
                check_audio()
            elif command.reset_filenames:
                reset_filenames()
            elif command.regenerate_thumbnails:
                regenerate_thumbnails()
        except errors.BaseError as e:
            print(e, file=stderr)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
