worker_processes 1;
user nginx;

error_log /dev/stderr warn;
pid /var/run/nginx.pid;

events {
    worker_connections 1024;
}

http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;

    log_format main '$remote_addr -> $request [$status] - '
                    'referer: $http_referer $http_x_forwarded_for';
    access_log /dev/stdout main;

    server_tokens off;
    keepalive_timeout 65;

    upstream backend {
        server __BACKEND__:6666;
    }

    # Signed file links (the server's file_link_secret, given here as
    # FILE_LINK_SECRET, filled in by docker-start.sh). The files of posts and
    # their thumbnails are served only to an address the server signed:
    # nginx's secure_link, ?e=<expiry>&s=<base64url of
    # md5("<expiry><path> <secret>")>, <path> the file's path under /data.
    # The same check as the Sardonyx image's, so that this port is no way
    # around it. Avatars are not signed. Without a secret, as before.
    map $uri $lithica_signed_path {
        "~^/data(?<rest>/(posts|generated-thumbnails)/.+)$" $rest;
        default "";
    }
    map "__FILE_LINK_SECRET__" $lithica_file_links_signed {
        "" 0;
        default 1;
    }
    map "$lithica_file_links_signed:$lithica_signed_path:$secure_link" $lithica_link_refused {
        "~^0:" 0;
        "~^1::" 0;
        "~^1:/[^:]+:1$" 0;
        default 1;
    }

    server {
        listen 80 default_server;
        listen [::]:80 default_server;

        location ~ ^/api$ {
            return 302 /api/;
        }

        location ~ ^/api/(.*)$ {
            tcp_nodelay on;

            # keep in step with max_upload_size in the server's config.yaml
            client_max_body_size 1073741824;

            gzip on;
            gzip_comp_level 3;
            gzip_min_length 20;
            gzip_proxied expired no-cache no-store private auth;
            gzip_types text/plain application/json;

            if ($request_uri ~* "/api/(.*)") {
                proxy_pass http://backend/$1;
            }

            error_page 500 502 503 504 @badproxy;
        }

        location /data/ {
            secure_link $arg_s,$arg_e;
            secure_link_md5 "$secure_link_expires$lithica_signed_path __FILE_LINK_SECRET__";
            if ($lithica_link_refused) {
                return 403 "Unauthorized";
            }

            rewrite ^/data/(.*) /$1 break;
            root /data;

            sendfile on;
            tcp_nopush on;
            tcp_nodelay on;

            error_page 403 @unauthorized;
            error_page 404 @notfound;
        }

        location / {
            root /var/www;
            try_files $uri /index.htm;

            sendfile on;
            tcp_nopush on;
            tcp_nodelay on;

            gzip_static on;
            gzip_proxied expired no-cache no-store private auth;
        }

        location @unauthorized {
            return 403 "Unauthorized";
            default_type text/plain;
        }

        location @notfound {
            return 404 "Not Found";
            default_type text/plain;
        }

        location @badproxy {
            return 502 "Failed to connect to szurubooru REST API";
            default_type text/plain;
        }
    }
}

daemon off;
