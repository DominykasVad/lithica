# Database credentials
POSTGRES_USER=lithica
POSTGRES_PASSWORD=changeme

# Build information: the legacy client shows it on its home page; both
# client images carry it as their version label
BUILD_INFO=latest

# Port of the web client, Sardonyx
# Set to 127.0.0.1:8080 if you wish to reverse-proxy the docker's port,
# otherwise the port specified here will be publicly accessible
PORT=8080

# The legacy client, optional: uncomment to start it with the rest, on
# LEGACY_PORT. It is the one to use for a site served under a path
# (BASE_URL); see doc/UPGRADING.md.
#COMPOSE_PROFILES=legacy
#LEGACY_PORT=8081

# How many requests one server process works on at the same time.
# 4 is the default. Raise it if requests queue up behind slow ones
# (large uploads, searches over many posts). Each thread can hold one
# database connection; a process opens at most 15.
THREADS=4

# How many server processes to start. Leave at 1 for now: running several
# has not been verified yet.
WORKERS=1

# URL base to run Lithica under, for the legacy client only: Sardonyx is
# served at the root of its host and ignores it
# See "Deployment notes" in doc/INSTALL.md
BASE_URL=/

# Directory to store image data
MOUNT_DATA=/var/local/lithica/data

# Directory to store database files
MOUNT_SQL=/var/local/lithica/sql

# Signed file links: when set, the files of posts and their thumbnails are
# served only to addresses the server signed, valid for one to two days.
# The same value goes to the server and the client images. Letters, digits,
# - and _ only, at least 32: openssl rand -hex 32. Changing it ends every
# link handed out so far (the clients ask for new ones). See the README.
FILE_LINK_SECRET=
